digraph DomainArchitecture {
  graph [
    rankdir=LR,
    bgcolor="#ffffff",
    fontname="Arial",
    fontsize=20,
    label="Cyclic Social Engine - Estructura del dominio",
    labelloc=t,
    pad=0.3,
    nodesep=0.45,
    ranksep=0.85,
    splines=polyline,
    compound=true
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=10,
    margin="0.14,0.10",
    color="#496573",
    fillcolor="#dff2e3"
  ];

  edge [
    color="#607d8b",
    arrowsize=0.7,
    fontname="Arial",
    fontsize=9
  ];

  catalog [
    label="CATALOGOS Y DEFINICIONES\n\nruleSetCatalog\nroleCatalog\ngroupCatalog\nstageCatalog\nrecipeCatalog\nactionCatalog\neventCatalog\npoolCatalog\nqueueCatalog",
    fillcolor="#e8f2f7"
  ];

  build [
    label="CONSTRUCCION DE SESSION\n\nbuildRuleSet\nbuildSession\ncreateSession\nvalidateSession",
    fillcolor="#e8f2f7"
  ];

  session [
    label="SESSION\n\nplayers\nroles\ngroups\ncycle\nqueues\nobjectiveRules\nselectionRules\nhistory\nlogs",
    fillcolor="#dcecf5",
    penwidth=1.5
  ];

  cycle [
    label="CYCLE\n\ncycleModel\nstartCycle\ntransiciones de superficie\nelige siguiente queue o pool",
    fillcolor="#dff2e3",
    penwidth=1.5
  ];

  queue [
    label="QUEUE\n\nqueueModel\nqueueBeforeConcealed\nqueueAfterConcealed\nqueueBeforeExposed\nqueueAfterExposed\nFIFO por queueKey",
    fillcolor="#dff2e3"
  ];

  pool [
    label="POOL\n\npoolModel\npoolConcealed\npoolExposed\nonEnter/onExit\ncursor de stages",
    fillcolor="#dff2e3"
  ];

  stage [
    label="STAGE\n\nstageModel\nstageCatalog\nactorIds\naudienceRoleIds\nrecipes\ncompletion",
    fillcolor="#dff2e3"
  ];

  recipe [
    label="RECIPE\n\nrecipeModel\nrecipeCatalog\nactorContract\ntargetContract\nconstraints\nusage",
    fillcolor="#dff2e3"
  ];

  action [
    label="ACTION\n\nactionModel\nactionCatalog\nactorModel\ntargetModel\nselect / inspect / link / set_property / conclude",
    fillcolor="#dff2e3"
  ];

  effect [
    label="EFFECT\n\neffectModel\neffectDefinition\nresolveEffects\napplyEffects\nset_property / set_group / reveal / conclude",
    fillcolor="#dff2e3"
  ];

  event [
    label="EVENT\n\neventModel\neventCatalog\nlee efectos finales\ncrea queueStages\ncancela queueStages",
    fillcolor="#dff2e3"
  ];

  objective [
    label="OBJECTIVES\n\nobjectiveModel\ncheck_objectives\nstable parity\nconclude_play",
    fillcolor="#dff2e3"
  ];

  history [
    label="HISTORY\n\nhistoryModel\ncycleHistory\npoolHistory\nqueueHistory\nstageHistory\nrecipeHistory\nactionHistory",
    fillcolor="#fff0c7",
    color="#c89223"
  ];

  surface [
    label="SURFACE\n\nsurfaceModel\nscreenHidden\nscreenReadonly\nscreenInteractive\nsurfaceMessages\nsurfaceItems",
    fillcolor="#e8f2f7"
  ];

  skin [
    label="SKIN Y UI\n\nskin filtra texto/assets\nUI pinta plano, stages y controles",
    fillcolor="#f3f3f3",
    color="#7a7a7a"
  ];

  catalog -> build -> session;
  session -> cycle;
  cycle -> queue [label="ejecuta por queueKey"];
  cycle -> pool [label="entra en pool"];
  queue -> stage [label="contiene stages"];
  pool -> stage [label="contiene stages"];
  stage -> recipe;
  recipe -> action;
  action -> effect;
  effect -> event [label="eventos derivados"];
  event -> queue [label="encola/remueve stages"];
  pool -> objective [label="onExit"];
  objective -> action [label="conclude_play"];
  session -> history [label="registra"];
  stage -> history [style=dashed];
  recipe -> history [style=dashed];
  action -> history [style=dashed];
  cycle -> surface [label="publicReveal/privateHide"];
  stage -> surface [label="proyeccion"];
  surface -> skin -> session [style=dashed, label="inputs"];
}
